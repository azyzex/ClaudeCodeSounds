# The shell installer must never be checked out with CRLF. A stray carriage
# return turns the shebang into an unrecognised interpreter and every line into
# "command not found". This covers notifier/claude-notify.sh too.
*.sh text eol=lf

# The templates the installers are generated from. These do not end in .sh or
# .ps1, so they need their own rules or they inherit the platform default and a
# CRLF checkout would leak carriage returns into the generated shell installer.
*.sh.in  text eol=lf
*.ps1.in text eol=crlf

# PowerShell is fine either way, but keep it consistent with Windows.
*.ps1 text eol=crlf

*.py   text eol=lf
*.yml  text eol=lf
*.md   text
LICENSE text

# Generated by build/generate.py from templates/ plus notifier/. Collapsed in
# diffs and pull requests, since reviewing the source is what matters.
install-claude-sound-alerts.sh  linguist-generated=true
install-claude-sound-alerts.ps1 linguist-generated=true
