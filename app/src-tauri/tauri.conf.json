{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Code Sounds",
  "version": "0.7.2",
  "identifier": "com.azyzex.claudecodesounds",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Claude Code Sounds",
        "width": 860,
        "height": 760,
        "minWidth": 620,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Configure Claude Code sound alerts",
    "longDescription": "A configurator for Claude Code sound alerts. The alerts themselves are shell and PowerShell hooks that keep working with or without this app installed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../notifier/claude-notify.sh": "notifier/claude-notify.sh",
      "../../notifier/claude-notify.ps1": "notifier/claude-notify.ps1",
      "../../sounds/default/*.wav": "sounds/default/"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/azyzex/ClaudeCodeSounds/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyNUI4REQxRTExMzc1RkQKUldUOWRSUGgwWTFiWWxrN0d3d1laTkRHZWwwZHJFSmxlSzhhc2FGWU9pa0R3aE92alZpdGJ2V00K"
    }
  }
}
